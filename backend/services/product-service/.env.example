# Auth Service specific environment variables
NODE_ENV=development
PORT=3002

# Database
DATABASE_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h 
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=7

MAX_LOGIN_ATTEMPTS=5

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=7200000
API_GATEWAY_URL=http://api-gateway:4000

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000


