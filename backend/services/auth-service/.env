# Auth Service specific environment variables
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=mysql://root:pardeep@127.0.0.1:3306/veggie_ecommerce

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_secure
JWT_EXPIRES_IN=24h 
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=7

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=2h


